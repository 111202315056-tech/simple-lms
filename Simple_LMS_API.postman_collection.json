{
  "info": {
    "name": "Simple LMS API",
    "description": "REST API Collection untuk Simple LMS dengan JWT Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student_test\",\n  \"email\": \"student@test.com\",\n  \"password\": \"password123\",\n  \"first_name\": \"Student\",\n  \"last_name\": \"Test\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.access_token);",
                  "pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "pm.test('Login berhasil', function() { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student_test\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {"raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"]}
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": {"raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Updated\",\n  \"last_name\": \"Name\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Courses (Public)",
      "item": [
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/courses?page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["courses"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "per_page", "value": "10"},
                {"key": "search", "value": "", "disabled": true},
                {"key": "min_price", "value": "", "disabled": true},
                {"key": "max_price", "value": "", "disabled": true}
              ]
            }
          }
        },
        {
          "name": "List Courses - Filter Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/courses?search=python",
              "host": ["{{base_url}}"],
              "path": ["courses"],
              "query": [{"key": "search", "value": "python"}]
            }
          }
        },
        {
          "name": "List Courses - Filter Price",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/courses?min_price=0&max_price=50000",
              "host": ["{{base_url}}"],
              "path": ["courses"],
              "query": [
                {"key": "min_price", "value": "0"},
                {"key": "max_price", "value": "50000"}
              ]
            }
          }
        },
        {
          "name": "Course Detail",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/courses/1", "host": ["{{base_url}}"], "path": ["courses", "1"]}
          }
        },
        {
          "name": "Course Detail - Not Found",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/courses/99999", "host": ["{{base_url}}"], "path": ["courses", "99999"]}
          }
        }
      ]
    },
    {
      "name": "Courses (Protected)",
      "item": [
        {
          "name": "Create Course (Instructor)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": {"raw": "{{base_url}}/courses", "host": ["{{base_url}}"], "path": ["courses"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kursus Django Ninja\",\n  \"description\": \"Belajar membangun REST API dengan Django Ninja\",\n  \"price\": 75000\n}"
            }
          }
        },
        {
          "name": "Update Course (Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": {"raw": "{{base_url}}/courses/1", "host": ["{{base_url}}"], "path": ["courses", "1"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 100000\n}"
            }
          }
        },
        {
          "name": "Delete Course (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {"raw": "{{base_url}}/courses/1", "host": ["{{base_url}}"], "path": ["courses", "1"]}
          }
        },
        {
          "name": "Create Course - Forbidden (Student)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": {"raw": "{{base_url}}/courses", "host": ["{{base_url}}"], "path": ["courses"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Forbidden\",\n  \"description\": \"Test\",\n  \"price\": 0\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "Enroll to Course",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {
              "raw": "{{base_url}}/enrollments?course_id=1",
              "host": ["{{base_url}}"],
              "path": ["enrollments"],
              "query": [{"key": "course_id", "value": "1"}]
            }
          }
        },
        {
          "name": "My Courses",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {"raw": "{{base_url}}/enrollments/my-courses", "host": ["{{base_url}}"], "path": ["enrollments", "my-courses"]}
          }
        },
        {
          "name": "Mark Progress",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {
              "raw": "{{base_url}}/enrollments/1/progress?completed=true",
              "host": ["{{base_url}}"],
              "path": ["enrollments", "1", "progress"],
              "query": [{"key": "completed", "value": "true"}]
            }
          }
        }
      ]
    }
  ]
}
